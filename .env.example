# Cấu hình Supabase (PostgreSQL Database & Realtime WebSocket cho phòng máy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cấu hình Google Apps Script Web App URL (Tự động đồng bộ bài tập vào Google Drive của Thầy)
NEXT_PUBLIC_GAS_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Tên trường và giáo viên
NEXT_PUBLIC_SCHOOL_NAME="Trường THCS Mão Điền"
NEXT_PUBLIC_TEACHER_NAME="Thầy Trương Thành Trường"
